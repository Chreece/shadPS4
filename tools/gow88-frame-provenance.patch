+// GOW88_FRAME_PROVENANCE: bounded readbacks using the existing screenshot path.
+static const std::filesystem::path& FrameProbeDirectory() {
+    static const std::filesystem::path directory = [] {
+        const char* env = std::getenv("SHADPS4_FRAME_PROBE_DIR");
+        if (!env || !*env) {
+            return std::filesystem::path{};
+        }
+        std::filesystem::path value{env};
+        if (!value.is_absolute() || !std::filesystem::is_directory(value)) {
+            return std::filesystem::path{};
+        }
+        return value;
+    }();
+    return directory;
+}
+
+static bool FrameProbeDue(u64 elapsed_ms, size_t& next) {
+    static constexpr std::array<u64, 8> times{0, 5000, 10000, 15000, 20000, 30000, 45000, 55000};
+    if (next == times.size() || elapsed_ms < times[next]) {
+        return false;
+    }
+    ++next;
+    return true;
+}
+
+struct FrameProbeSample {
+    bool capture{};
+    u64 ordinal{};
+    u64 elapsed_ms{};
+};
+
+static FrameProbeSample FrameProbeTick(bool displayed) {
+    if (FrameProbeDirectory().empty()) {
+        return {};
+    }
+    struct Clock {
+        std::mutex mutex;
+        std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
+        size_t next{};
+        u64 count{};
+    };
+    static std::array<Clock, 2> clocks;
+    auto& clock = clocks[displayed ? 1 : 0];
+    std::lock_guard lock{clock.mutex};
+    const auto elapsed = static_cast<u64>(std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now() - clock.start).count());
+    return {FrameProbeDue(elapsed, clock.next), ++clock.count, elapsed};
+}
+
+struct FrameProbePixels {
+    u64 pixels{};
+    u64 nonblack{};
+    u64 rgb_sum{};
+    u32 max_rgb{};
+};
+
+static FrameProbePixels FrameProbeSummarize(std::span<const u8> rgba) {
+    FrameProbePixels result{};
+    for (size_t i = 0; i + 3 < rgba.size(); i += 4) {
+        const auto r = rgba[i];
+        const auto g = rgba[i + 1];
+        const auto b = rgba[i + 2];
+        ++result.pixels;
+        result.nonblack += r != 0 || g != 0 || b != 0;
+        result.rgb_sum += static_cast<u64>(r) + g + b;
+        result.max_rgb = std::max(result.max_rgb, static_cast<u32>(std::max({r, g, b})));
+    }
+    return result;
+}
