  "root_defect": {
    "observed": "GoT records 631 oversized buffer clamps; two live bindings span approximately 1.4 GiB each. Its final IR accesses only bounded prefixes. GoW records 3557 oversized clamps across multiple shaders.",
    "mechanism": "BindBuffers reconciles complete guest descriptor extents through ObtainBuffer, which calls texture ReadMemory before residency and synchronization. Unaccessed image aliases therefore incur readback and hazard work.",
    "correction": "Derive conservative byte prefixes from final IR, include scalar/vector/atomic widths, bind min(guest descriptor size, proven prefix), preserve shared backing for narrowed bindings and bump shader metadata 14 to 15.",
    "proven_capture_prefixes_bytes": [
      32,
      272
    ],
    "fallback": "Unknown addresses, overflow, cyclic/deep expressions, unsupported formats and any unproven access retain the full descriptor range. Unreferenced and special resources retain default ranges. Runtime-selected BDA reads are not capped by this analysis.",
    "depth_compare_reference": "https://docs.vulkan.org/spec/latest/chapters/textures.html#textures-depth-compare-operation",
    "per_game_changes": false,
    "limits": "The excess synchronization is established. Its contribution to black output or native FPS is not yet measured. Full universal DS support and menu/gameplay recovery are not claimed."
