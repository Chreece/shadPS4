+            --cmake "${CMAKE_COMMAND}" --ninja "${cpu_id_ninja}" --jobs 2
+        BUILD_ALWAYS TRUE
+        INSTALL_COMMAND "")
+    ExternalProject_Add(shadps4_cpu_id_bundle
