     // Called on main thread
     SDL_Event event;

-    if (!SDL_WaitEvent(&event)) {
+    const auto command = ScalarAB::Control();
+    if (command == "quit") {
+        is_open = false;
+        return;
+    }
+    if (command == "screenshot") {
+        VideoCore::RequestScreenshot(VideoCore::ScreenshotRequest::GameOnly);
+    }
+    const bool received =
+        ScalarAB::Enabled() ? SDL_WaitEventTimeout(&event, 100) : SDL_WaitEvent(&event);
