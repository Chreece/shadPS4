                                                 Xbyak::CodeGenerator& c, bool rsqrt, bool vex) {
+    const size_t ab_index = (rsqrt ? 2 : 0) + (vex ? 1 : 0);
+    ScalarAB::sites[ab_index].fetch_add(1, std::memory_order_relaxed);
     const bool table_loaded = InitializeIndexTables();
