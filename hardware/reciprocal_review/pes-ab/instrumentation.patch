+    if (ScalarAB::Diagnostic()) {
+        c.mov(rcx, reinterpret_cast<u64>(&ScalarAB::hits[ab_index]));
+        c.lock();
+        c.inc(qword[rcx]);
+        Xbyak::Label unchanged;
+        c.test(eax, eax);
+        c.jz(unchanged);
+        c.mov(rcx, reinterpret_cast<u64>(&ScalarAB::changes[ab_index]));
+        c.lock();
+        c.inc(qword[rcx]);
+        c.L(unchanged);
+    }
+
