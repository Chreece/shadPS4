// This fixture compiles the EXACT production Translator::RecordOrderedGdsCheckpoint
// method, inserted below. No emulator, GPU, guest shader or fake counter value.
// We verify each live input at the original guest ordered-count site.
#include <array>
#include <cassert>
#include <cstddef>
#include <cstdint>
#include <iostream>
#include <stdexcept>
#include <vector>

using u32 = std::uint32_t;
using s32 = std::int32_t;
using f32 = float;
using u64 = std::uint64_t;
namespace Shader::Gcn::OrderedGds {
inline constexpr u32 GcnWaveLanes = 64;
inline constexpr u32 GcnCheckpointAbiVersion = 2;
}
#define ASSERT_MSG(cond, ...) do { if (!(cond)) throw std::invalid_argument("invalid live ordered GDS wave state"); } while (false)

enum class HwStage { Compute, Fragment };
struct RuntimeInfo {
    HwStage hw_stage{HwStage::Compute};
    struct Properties { u32 num_allocated_vgprs{9}; } props;
    struct {
        struct { std::array<u32,3> workgroup_size{128,1,1}; } cs;
    } hw;
};

namespace IR {
struct U32 { u32 value{}; };
struct F32 { f32 value{}; };
struct U1 { bool value{}; };
struct U64 { u64 value{}; };
enum class Attribute { WorkgroupIndex, LocalInvocationIndex };
struct Value { u32 lo{}, hi{}; };
enum class ScalarReg : u32 {};
enum class VectorReg : u32 {};
inline constexpr std::size_t NumScalarRegs = 104;
inline constexpr std::size_t NumVectorRegs = 256;
struct IREmitter {
    struct Capture { u32 pc{}, bank{}, index{}, value{}, slot{}, lane{}; };
    std::vector<Capture> records;
    u32 m0{0x12345566u};
    u32 vcc_lo{0x1234abcd};
    u32 vcc_hi{0xff223344u};
    bool scc{true};
    u32 workgroup_index{2};
    u32 local_invocation_index{71};
    U32 GetAttributeU32(Attribute a) const {
        return {a == Attribute::WorkgroupIndex ? workgroup_index : local_invocation_index};
    }
    U32 IDiv(U32 a, U32 b) const { return {a.value / b.value}; }
    U32 IMod(U32 a, U32 b) const { return {a.value % b.value}; }
    U32 IMul(U32 a, U32 b) const { return {a.value * b.value}; }
    U32 IAdd(U32 a, U32 b) const { return {a.value + b.value}; }
    // Match all three REAL production IREmitter overloads. A fixture with
    // only the unsigned overload concealed the size_t ambiguity that broke
    // the latest native compilation. Reverting the explicit u32 cast must
    // now fail strict GCC and Clang fixture compilation as well.
    U32 Imm32(u32 v) const { return {v}; }
    U32 Imm32(s32 v) const { return {u32(v)}; }
    F32 Imm32(f32 v) const { return {v}; }
    template<typename T = U32> T GetScalarReg(ScalarReg r) const {
        return {0x51000000u + static_cast<u32>(r)};
    }
    template<typename T = U32> T GetVectorReg(VectorReg r) const {
        return {0x62000000u + static_cast<u32>(r)};
    }
    U32 GetM0() const { return {m0}; }
    U32 GetVccLo() const { return {vcc_lo}; }
    U32 GetVccHi() const { return {vcc_hi}; }
    U1 GetScc() const { return {scc}; }
    u32 Select(U1 condition, U32 when_true, U32 when_false) const {
        return condition.value ? when_true.value : when_false.value;
    }
    Value UnpackUint2x32(U64 mask) const {
        return {u32(mask.value), u32(mask.value >> 32)};
    }
    u32 CompositeExtract(Value v, std::size_t i) const {
        assert(i < 2);
        return i ? v.hi : v.lo;
    }
    void OrderedGdsCheckpointRegister(U32 site_pc, U32 bank, U32 index, U32 value,
                                      U32 logical_slot, U32 lane) {
        records.push_back({site_pc.value, bank.value, index.value, value.value,
                           logical_slot.value, lane.value});
    }
};
}
struct Translator {
    IR::IREmitter ir;
    RuntimeInfo runtime_info;
    void RecordOrderedGdsCheckpoint(const IR::U32& site_pc,
                                    const IR::U64& exec_mask,
                                    u32 next_guest_pc, u32 destination_vgpr);
};
/* EXACT_LIVE_GCN_CHECKPOINT_HELPER */

int main() {
    Translator t;
    constexpr u32 pc = 0x4158;
    constexpr u64 mask = 0x8000000000000081ULL;
    t.RecordOrderedGdsCheckpoint(t.ir.Imm32(pc), IR::U64{mask}, 0x4160, 5);
    assert(t.ir.records.size() == 104 + 9 + 6 + 11);
    for (const auto& record : t.ir.records) {
        assert(record.slot == 5u && record.lane == 7u);
    }
    for (u32 i = 0; i < 104; ++i) {
        const auto& v = t.ir.records[i];
        assert(v.pc == pc && v.bank == 0 && v.index == i &&
               v.value == 0x51000000u + i);
    }
    for (u32 i = 0; i < 9; ++i) {
        const auto& v = t.ir.records[104 + i];
        assert(v.pc == pc && v.bank == 1 && v.index == i &&
               v.value == 0x62000000u + i);
    }
    const auto& r = t.ir.records;
    for (u32 i = 0; i < 6; ++i) {
        assert(r[113 + i].pc == pc && r[113 + i].bank == 2 &&
               r[113 + i].index == i);
    }
    assert(r[113].value == 0x12345566u);
    assert(r[114].value == 0x1234abcdu);
    assert(r[115].value == 0xff223344u);
    assert(r[116].value == 1u);
    assert(r[117].value == 0x81u);
    assert(r[118].value == 0x80000000u);
    // The 11 live site-metadata words must preserve actual decoded PC,
    // return PC, VDST and physical GPU wave slot; tag/flags stay invalid.
    constexpr std::array<u32,11> expected_header{
        0, pc, 0x4160, 5, 5, 104, 9, 64, 0, 0, 2};
    for (u32 i = 0; i < expected_header.size(); ++i) {
        const auto& h = r[119 + i];
        assert(h.bank == 3 && h.index == i && h.value == expected_header[i]);
    }

    // Same instrumentation works at a second real static site with a
    // different allocated-VGPR count, M0, SCC and guest EXEC mask.
    const auto previous = t.ir.records.size();
    t.ir.m0 = 0xfecd0012u;
    t.ir.scc = false;
    t.runtime_info.props.num_allocated_vgprs = 4;
    t.runtime_info.hw.cs.workgroup_size = {64,1,1};
    t.ir.workgroup_index = 9;
    t.ir.local_invocation_index = 63;
    t.RecordOrderedGdsCheckpoint(t.ir.Imm32(0x41d4), IR::U64{0x0000000200000100ULL},
                                 0x41dc, 3);
    assert(t.ir.records.size() - previous == 104 + 4 + 6 + 11);
    for (std::size_t n = previous; n < t.ir.records.size(); ++n) {
        assert(t.ir.records[n].slot == 9u && t.ir.records[n].lane == 63u);
    }
    assert(t.ir.records[previous].pc == 0x41d4 &&
           t.ir.records[previous].bank == 0);
    const auto special = previous + 104 + 4;
    assert(t.ir.records[special].value == 0xfecd0012u);
    assert(t.ir.records[special + 3].value == 0u);
    assert(t.ir.records[special + 4].value == 0x100u);
    assert(t.ir.records[special + 5].value == 2u);
    constexpr std::array<u32,11> expected_second_header{
        0, 0x41d4, 0x41dc, 9, 3, 104, 4, 64, 0, 0, 2};
    for (u32 i = 0; i < expected_second_header.size(); ++i) {
        const auto& h = t.ir.records[special + 6 + i];
        assert(h.bank == 3 && h.index == i && h.value == expected_second_header[i]);
    }

    const auto before_error = t.ir.records.size();
    auto reject = [&](auto change) {
        change();
        bool threw = false;
        try {
            t.RecordOrderedGdsCheckpoint(t.ir.Imm32(pc), IR::U64{mask}, 0x4160, 3);
        }
        catch (const std::invalid_argument&) { threw = true; }
        assert(threw && t.ir.records.size() == before_error);
    };
    reject([&] { t.runtime_info.hw_stage = HwStage::Fragment; });
    t.runtime_info.hw_stage = HwStage::Compute;
    reject([&] { t.runtime_info.props.num_allocated_vgprs = 0; });
    reject([&] { t.runtime_info.props.num_allocated_vgprs = 257; });
    t.runtime_info.props.num_allocated_vgprs = 4;
    reject([&] { t.runtime_info.hw.cs.workgroup_size = {0,1,1}; });
    reject([&] { t.runtime_info.hw.cs.workgroup_size = {1025,1,1}; });
    t.runtime_info.hw.cs.workgroup_size = {64,1,1};
    t.runtime_info.props.num_allocated_vgprs = 4;
    bool bad_decoded = false;
    try { t.RecordOrderedGdsCheckpoint(t.ir.Imm32(pc), IR::U64{mask}, 0x4160, 4); }
    catch (const std::invalid_argument&) { bad_decoded = true; }
    assert(bad_decoded && t.ir.records.size() == before_error);
    bad_decoded = false;
    try { t.RecordOrderedGdsCheckpoint(t.ir.Imm32(pc), IR::U64{mask}, 7, 3); }
    catch (const std::invalid_argument&) { bad_decoded = true; }
    assert(bad_decoded && t.ir.records.size() == before_error);
    std::cout << "GDS_ORDERED_LIVE_REGISTER_CAPTURE=PASS "
                 "sgprs=104 vgprs=9/4 specials=6 "
                 "dynamic_m0_exec_vcc_scc=PASS two_sites=PASS "
                 "physical_wave_slot_lane=PASS decoded_site_header_invalid_auth=PASS "
                 "invalid_dimensions_rejected=PASS "
                 "GUEST_SHADER_GPU_WRITER_NOT_ENABLED\n";
}
