// Exact production methods are inserted by check_ordered_gds_frontend.py.
// These test doubles record IR values; no GPU, Vulkan, guest shader, or fake
// counter results are sent to any emulator runtime.
#include <algorithm>
#include <cassert>
#include <cstdint>
#include <stdexcept>
#include <iostream>
#include <vector>
using u32 = std::uint32_t;
#define ASSERT_MSG(cond, ...) do { if (!(cond)) throw std::invalid_argument("invalid DS_ORDERED_COUNT"); } while (false)

namespace IR {
struct U32 { u32 value; };
struct U1 { bool value; };
struct U64 { std::uint64_t value; };
enum class Opcode { OrderedGdsCount };
struct IREmitter {
    u32 current_m0{};
    bool exec{};
    std::uint64_t wave_mask{};
    struct Call { Opcode opcode; u32 m0; u32 address; std::uint64_t exec_mask; u32 control; u32 site_pc; };
    Call recorded{};
    unsigned count{};
    U32 GetM0() const { return {current_m0}; }
    U1 GetExec() const { return {exec}; }
    U64 Ballot(const U1& predicate) const { return {predicate.value ? wave_mask : 0ULL}; }
    U32 Imm32(u32 v) const { return {v}; }
    template<class R> R Inst(Opcode opcode,const U32& m0,const U32& addr,
                              const U64& guest_exec_mask,const U32& control,const U32& site_pc) {
        recorded={opcode,m0.value,addr.value,guest_exec_mask.value,control.value,site_pc.value};
        count++;
        return R{0x1234abcd}; // Only a test sentinel, NOT a guest counter.
    }
    U32 OrderedGdsCount(const U32& m0, const U32& address, const U64& guest_exec_mask, const U32& encoded_control,
                        const U32& site_pc);
};
}
// Mirror the production decoded Operand fields read by DS_ORDERED_COUNT.
// Keep field before code so accidental mock-only aggregate assumptions fail.
enum class OperandField { Undefined, ScalarGPR, VectorGPR };
struct Operand {
    OperandField field{OperandField::Undefined};
    u32 code{0xffffffffu};
};
struct InstControlDS { u32 offset0; u32 offset1; bool gds; };
struct InstControl { InstControlDS ds; };
struct GcnInst { InstControl control; Operand src[3]; Operand dst[1]; u32 length; };
struct MockInfo {
    bool uses_ordered_gds{};
    std::vector<u32> ordered_gds_site_pcs;
    struct OrderedGdsSite {
        u32 pc{};
        u32 destination_vgpr{};
        u32 encoded_control{};
    };
    std::vector<OrderedGdsSite> ordered_gds_sites;
};
struct Translator {
    IR::IREmitter ir;
    MockInfo info;
    u32 pc{0x4160u};
    u32 source_value{};
    u32 written_value{};
    u32 written_reg{};
    unsigned checkpoint_calls{};
    u32 last_checkpoint_site{};
    std::uint64_t last_checkpoint_exec{};
    u32 last_checkpoint_next_pc{};
    u32 last_checkpoint_vdst{};
    void RecordOrderedGdsCheckpoint(const IR::U32& site, const IR::U64& mask,
                                    u32 next_pc, u32 vdst) {
        ++checkpoint_calls;
        last_checkpoint_site = site.value;
        last_checkpoint_exec = mask.value;
        last_checkpoint_next_pc = next_pc;
        last_checkpoint_vdst = vdst;
    }
    IR::U32 GetSrc(const Operand& op) { assert(op.code==9); return {source_value}; }
    void SetDst(const Operand& dst, IR::U32 v) {written_reg=dst.code; written_value=v.value;}
    void DS_ORDERED_COUNT(const GcnInst& inst);
};

namespace IR {
/* EXACT_EMITTER */
}
/* EXACT_TRANSLATOR */

int main() {
    Translator t;
    t.ir.current_m0=0x12340567u;
    t.ir.exec=true;
    t.ir.wave_mask=0x8000000000000080ULL;
    t.source_value=0x87654321u;
    GcnInst inst{};
    inst.control.ds = {4u, 0x13u, true};
    inst.src[0] = {OperandField::VectorGPR, 9};
    inst.dst[0] = {OperandField::VectorGPR, 11};
    inst.length = 8u;
    t.DS_ORDERED_COUNT(inst);
    assert(t.info.uses_ordered_gds && t.ir.count==1);
    assert(t.ir.recorded.opcode==IR::Opcode::OrderedGdsCount);
    assert(t.ir.recorded.m0==0x12340567u && t.ir.recorded.address==0x87654321u);
    assert(t.ir.recorded.exec_mask==0x8000000000000080ULL && t.ir.recorded.control==0x1304u);
    assert(t.ir.recorded.site_pc==0x4158u);
    assert(t.checkpoint_calls==1 && t.last_checkpoint_site==0x4158u &&
           t.last_checkpoint_exec==0x8000000000000080ULL &&
           t.last_checkpoint_next_pc==0x4160u && t.last_checkpoint_vdst==11);
    assert(t.info.ordered_gds_site_pcs.size()==1 && t.info.ordered_gds_site_pcs[0]==0x4158u);
    assert(t.info.ordered_gds_sites.size()==1);
    assert(t.info.ordered_gds_sites[0].pc==0x4158u &&
           t.info.ordered_gds_sites[0].destination_vgpr==11u &&
           t.info.ordered_gds_sites[0].encoded_control==0x1304u);
    assert(t.written_reg==11 && t.written_value==0x1234abcdu);
    // The second ordered instruction must preserve distinct Add and new M0/EXEC.
    t.pc=0x41dcu;
    t.ir.current_m0=0x88aa0812u;
    t.ir.exec=false;
    t.ir.wave_mask=0;
    inst.control.ds.offset1=0x03u;
    t.DS_ORDERED_COUNT(inst);
    assert(t.ir.count==2 && t.ir.recorded.control==0x0304u);
    assert(t.ir.recorded.site_pc==0x41d4u);
    assert(t.checkpoint_calls==2 && t.last_checkpoint_site==0x41d4u &&
           t.last_checkpoint_exec==0 && t.last_checkpoint_next_pc==0x41dcu &&
           t.last_checkpoint_vdst==11);
    assert(t.info.ordered_gds_site_pcs.size()==2 && t.info.ordered_gds_site_pcs[1]==0x41d4u);
    assert(t.info.ordered_gds_sites.size()==2);
    assert(t.info.ordered_gds_sites[1].pc==0x41d4u &&
           t.info.ordered_gds_sites[1].destination_vgpr==11u &&
           t.info.ordered_gds_sites[1].encoded_control==0x0304u);
    assert(t.ir.recorded.exec_mask==0 && t.ir.recorded.m0==0x88aa0812u);
    bool rejected=false;
    inst.control.ds.gds=false;
    try {t.DS_ORDERED_COUNT(inst);} catch(const std::invalid_argument&) {rejected=true;}
    assert(rejected && t.ir.count==2);
    inst.control.ds.gds=true;inst.control.ds.offset0=5u;
    rejected=false;
    try {t.DS_ORDERED_COUNT(inst);} catch(const std::invalid_argument&) {rejected=true;}
    assert(rejected && t.ir.count==2);
    inst.control.ds.offset0=4u;inst.control.ds.offset1=0x02u;
    rejected=false;
    try {t.DS_ORDERED_COUNT(inst);} catch(const std::invalid_argument&) {rejected=true;}
    assert(rejected && t.ir.count==2);
    // Use a NEW static site so an already-recorded site cannot hide an
    // invalid destination. These test guards exercise the exact translator.
    inst.control.ds.offset1=0x03u;
    t.pc=0x4208u;
    inst.dst[0].field=OperandField::ScalarGPR;
    rejected=false;
    try {t.DS_ORDERED_COUNT(inst);} catch(const std::invalid_argument&) {rejected=true;}
    assert(rejected && t.ir.count==2 && t.info.ordered_gds_sites.size()==2);
    inst.dst[0].field=OperandField::VectorGPR;
    inst.dst[0].code=256u;
    rejected=false;
    try {t.DS_ORDERED_COUNT(inst);} catch(const std::invalid_argument&) {rejected=true;}
    assert(rejected && t.ir.count==2 && t.info.ordered_gds_sites.size()==2);
    inst.dst[0].code=11u;
    // A repeated translation of the same static instruction must not
    // fabricate a third site even when a dynamic epoch executes it again.
    t.pc=0x41dcu;
    t.DS_ORDERED_COUNT(inst);
    assert(t.ir.count==3 && t.checkpoint_calls==3 &&
           t.last_checkpoint_next_pc==0x41dcu &&
           t.last_checkpoint_vdst==11 &&
           t.info.ordered_gds_site_pcs.size()==2 &&
           t.info.ordered_gds_sites.size()==2);
    std::cout<<"GDS_ORDERED_FRONTEND_EXTRACTED=PASS ops=3 sites=2 invalid_vdst_rejected=2 checkpoint_called=3 decoded_site_vdst_next_pc=PASS NO_GPU_WORK\n";
}
