+    if args.cxx:
+        compilers.append("-DCMAKE_CXX_COMPILER=" + args.cxx)
+    run(args.cmake, "-S", ROOT, "-B", build, *generator, *compilers, "-DCMAKE_BUILD_TYPE=Release",
