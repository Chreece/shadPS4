-Id EmitReadConstBuffer(EmitContext& ctx, u32 handle, Id index) {
-    const auto& buffer = ctx.buffers[handle];
+Id EmitReadConstBuffer(EmitContext& ctx, const IR::Value& handle, Id index) {
+    if (!handle.IsImmediate()) {
+        // Raw guest V# selected by the running GPU shader. Preserve the
+        // complete 40-bit address, original stride/record count and type.
+        // No host-selected buffer or fabricated descriptor is substituted.
+        ASSERT(ctx.info.uses_dma && Sirit::ValidId(ctx.get_bda_pointer));
+        const Id raw = ctx.Def(handle);
+        const Id dw0 = ctx.OpCompositeExtract(ctx.U32[1], raw, 0u);
+        const Id dw1 = ctx.OpCompositeExtract(ctx.U32[1], raw, 1u);
+        const Id dw2 = ctx.OpCompositeExtract(ctx.U32[1], raw, 2u);
+        const Id dw3 = ctx.OpCompositeExtract(ctx.U32[1], raw, 3u);
+        const Id base_hi = ctx.OpBitwiseAnd(ctx.U32[1], dw1, ctx.ConstU32(0xffu));
+        const Id base = ctx.OpBitwiseOr(
+            ctx.U64, ctx.OpUConvert(ctx.U64, dw0),
+            ctx.OpShiftLeftLogical(ctx.U64, ctx.OpUConvert(ctx.U64, base_hi),
+                                   ctx.ConstU32(32u)));
+        const Id stride = ctx.OpBitFieldUExtract(
+            ctx.U32[1], dw1, ctx.ConstU32(16u), ctx.ConstU32(14u));
+        const Id length = ctx.OpSelect(
+            ctx.U32[1], ctx.OpIEqual(ctx.U1[1], stride, ctx.u32_zero_value),
+            dw2, ctx.OpIMul(ctx.U32[1], dw2, stride));
+        // Bounds are checked in dwords before the multiplication by four,
+        // avoiding 32-bit overflow from a guest-controlled index.
+        const Id valid_length = ctx.OpUGreaterThanEqual(
+            ctx.U1[1], length, ctx.ConstU32(4u));
+        const Id last_index = ctx.OpShiftRightLogical(
+            ctx.U32[1], ctx.OpISub(ctx.U32[1], length, ctx.ConstU32(4u)),
+            ctx.ConstU32(2u));
+        const Id valid_index = ctx.OpULessThanEqual(ctx.U1[1], index, last_index);
+        const Id valid_type = ctx.OpIEqual(
+            ctx.U1[1], ctx.OpShiftRightLogical(ctx.U32[1], dw3, ctx.ConstU32(30u)),
+            ctx.u32_zero_value);
+        const Id valid = ctx.OpLogicalAnd(
+            ctx.U1[1], valid_type, ctx.OpLogicalAnd(
+                ctx.U1[1], valid_length, ctx.OpLogicalAnd(
+                    ctx.U1[1], valid_index,
+                    ctx.OpINotEqual(ctx.U1[1], base, ctx.u64_zero_value))));
+        const Id read_label = ctx.OpLabel();
+        const Id null_label = ctx.OpLabel();
+        const Id merge_label = ctx.OpLabel();
+        ctx.OpSelectionMerge(merge_label, spv::SelectionControlMask::MaskNone);
+        ctx.OpBranchConditional(valid, read_label, null_label);
+        ctx.AddLabel(read_label);
+        const Id address = ctx.OpIAdd(
+            ctx.U64, base, ctx.OpUConvert(
+                ctx.U64, ctx.OpShiftLeftLogical(ctx.U32[1], index, ctx.ConstU32(2u))));
+        const Id value = ctx.EmitDwordMemoryRead(address, [&] {
+            return ctx.u32_zero_value;
+        });
+        ctx.OpBranch(merge_label);
+        const Id actual_read_label = ctx.last_label;
+        ctx.AddLabel(null_label);
+        ctx.OpBranch(merge_label);
+        ctx.AddLabel(merge_label);
+        return ctx.OpPhi(ctx.U32[1], value, actual_read_label,
+                         ctx.u32_zero_value, null_label);
+    }
+    const auto& buffer = ctx.buffers[handle.U32()];
     if (const Id offset = buffer.Offset(PointerSize::B32); Sirit::ValidId(offset)) {
         index = ctx.OpIAdd(ctx.U32[1], index, offset);
     }
