+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <mutex>
+#include <optional>
+#include <string_view>
+#include <vulkan/vulkan_core.h>
+
+namespace Vulkan::DeviceFault {
+
+constexpr std::uint32_t AddressCapacity = 64;
+constexpr std::uint32_t VendorCapacity = 16;
+
+struct Report {
+    VkResult counts_result{VK_ERROR_UNKNOWN};
+    VkResult details_result{VK_ERROR_UNKNOWN};
+    std::uint32_t available_addresses{};
+    std::uint32_t available_vendors{};
+    std::uint64_t available_binary_bytes{};
+    std::uint32_t address_count{};
+    std::uint32_t vendor_count{};
+    bool queried_details{};
+    bool truncated{};
+    std::array<char, VK_MAX_DESCRIPTION_SIZE> description{};
+    std::array<VkDeviceFaultAddressInfoEXT, AddressCapacity> addresses{};
+    std::array<VkDeviceFaultVendorInfoEXT, VendorCapacity> vendors{};
+};
+
+inline std::string_view BoundedText(const char* text, std::size_t capacity) {
+    return {text, static_cast<std::size_t>(std::find(text, text + capacity, '\0') - text)};
+}
+
+// Called only after VK_ERROR_DEVICE_LOST. No normal-frame polling or GPU wait.
+// Two bounded calls, no binary dumps, and no allocations based on driver counts.
+template <class Query>
+Report Capture(Query&& query) {
+    Report out{};
+    VkDeviceFaultCountsEXT counts{};
+    counts.sType = VK_STRUCTURE_TYPE_DEVICE_FAULT_COUNTS_EXT;
+    out.counts_result = query(&counts, nullptr);
+    if (out.counts_result != VK_SUCCESS && out.counts_result != VK_INCOMPLETE) {
+        return out;
+    }
+    out.available_addresses = counts.addressInfoCount;
+    out.available_vendors = counts.vendorInfoCount;
+    out.available_binary_bytes = counts.vendorBinarySize;
+    counts.addressInfoCount = std::min(counts.addressInfoCount, AddressCapacity);
+    counts.vendorInfoCount = std::min(counts.vendorInfoCount, VendorCapacity);
+    counts.vendorBinarySize = 0;
+    const auto supplied_addresses = counts.addressInfoCount;
+    const auto supplied_vendors = counts.vendorInfoCount;
+    VkDeviceFaultInfoEXT info{};
+    info.sType = VK_STRUCTURE_TYPE_DEVICE_FAULT_INFO_EXT;
+    info.pAddressInfos = supplied_addresses ? out.addresses.data() : nullptr;
+    info.pVendorInfos = supplied_vendors ? out.vendors.data() : nullptr;
+    info.pVendorBinaryData = nullptr;
+    out.queried_details = true;
+    out.details_result = query(&counts, &info);
+    if (out.details_result != VK_SUCCESS && out.details_result != VK_INCOMPLETE) {
+        return out;
+    }
+    out.address_count = std::min(counts.addressInfoCount, supplied_addresses);
+    out.vendor_count = std::min(counts.vendorInfoCount, supplied_vendors);
+    std::copy_n(info.description, out.description.size(), out.description.begin());
+    out.truncated = out.details_result == VK_INCOMPLETE ||
+                    out.available_addresses > supplied_addresses ||
+                    out.available_vendors > supplied_vendors ||
+                    out.available_binary_bytes != 0;
+    return out;
+}
+
+struct Entry {
+    VkDevice device{VK_NULL_HANDLE};
+    PFN_vkGetDeviceFaultInfoEXT query{};
+    bool reported{};
+};
+inline std::array<Entry, 4> devices{};
+inline std::mutex devices_mutex;
+
+inline bool Register(VkDevice device, PFN_vkGetDeviceFaultInfoEXT query) {
+    if (device == VK_NULL_HANDLE || query == nullptr) {
+        return false;
+    }
+    std::scoped_lock lock{devices_mutex};
+    for (auto& entry : devices) {
+        if (entry.device == device) {
+            entry = {device, query, false};
+            return true;
+        }
+    }
+    for (auto& entry : devices) {
+        if (entry.device == VK_NULL_HANDLE) {
+            entry = {device, query, false};
+            return true;
+        }
+    }
+    return false;
+}
+
+inline void Forget(VkDevice device) {
+    std::scoped_lock lock{devices_mutex};
+    for (auto& entry : devices) {
+        if (entry.device == device) {
+            entry = {};
+        }
+    }
+}
+
+inline std::optional<Report> OnResult(VkDevice device, VkResult result) {
+    if (result != VK_ERROR_DEVICE_LOST) {
+        return std::nullopt;
+    }
+    PFN_vkGetDeviceFaultInfoEXT query{};
+    {
+        std::scoped_lock lock{devices_mutex};
+        for (auto& entry : devices) {
+            if (entry.device == device && entry.query && !entry.reported) {
+                entry.reported = true;
+                query = entry.query;
+                break;
+            }
+        }
+    }
+    if (!query) {
+        return std::nullopt;
+    }
+    return Capture([&](VkDeviceFaultCountsEXT* counts, VkDeviceFaultInfoEXT* info) {
+        return query(device, counts, info);
+    });
+}
+
+} // namespace Vulkan::DeviceFault
