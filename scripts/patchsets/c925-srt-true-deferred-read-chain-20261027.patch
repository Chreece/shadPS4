+// Preserve the exact reads rejected by scheduling. The earlier diagnostic
+// scanned all unflattened reads, most of which were *not* the four stalled
+// operands. No read, canonical map, or code-generation state is changed.
+static void RecordBlockedSrtRead(PassInfo& pass, const char* why,
+                                 const IR::Inst* ptr, const IR::Inst* read,
+                                 const IR::Value& offset) {
+    for (const auto& event : pass.blocked_reads) {
+        if (event.read == read && event.pointer == ptr &&
+            std::string_view(event.reason) == why) {
+            return;
+        }
+    }
+    if (pass.blocked_reads.size() < 64) {
+        pass.blocked_reads.push_back({why, ptr, read, offset});
+    }
+}
+
+static std::string DescribeSrtOffset(const IR::Value& value, int depth,
+                                     std::unordered_set<const IR::Inst*>& seen) {
+    if (value.IsEmpty()) return "empty";
+    if (value.IsImmediate()) {
+        return value.Type() == IR::Type::U32
+                   ? fmt::format("imm({:#x})", value.U32()) : "imm(other)";
+    }
+    const auto* inst = value.TryInst();
+    if (!inst) return "unknown_value";
+    std::string desc = fmt::format("{}", magic_enum::enum_name(inst->GetOpcode()));
+    if (inst->GetOpcode() == IR::Opcode::ReadConst ||
+        inst->GetOpcode() == IR::Opcode::ReadConstBuffer) {
+        desc += fmt::format("[flat={}]", GetFlatbufOffset(inst));
+    }
+    if (depth >= 4 || !seen.insert(inst).second) return desc;
+    desc += "(";
+    for (size_t i = 0; i < inst->NumArgs() && i < 3; ++i) {
+        if (i) desc += ",";
+        desc += DescribeSrtOffset(inst->Arg(i), depth + 1, seen);
+        if (desc.size() >= 400) break;
+    }
+    desc += ")";
+    seen.erase(inst);
+    return desc;
+}
