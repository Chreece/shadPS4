--- /dev/null
+++ b/src/common/log_occurrence_gate.h
@@ -0,0 +1,23 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <type_traits>
+
+namespace Common {
+
+// Preserve first occurrences and logarithmically spaced cumulative reports.
+// Only the decision to log changes; callers' emulated behavior is untouched.
+// The caller may record the precise count for the retained diagnostic.
+template <typename Counter>
+[[nodiscard]] inline bool ShouldReportRepeatedEvent(
+    std::atomic<Counter>& total, Counter& occurrence) noexcept {
+    static_assert(std::is_unsigned_v<Counter>);
+    occurrence = total.fetch_add(Counter{1}, std::memory_order_relaxed) + Counter{1};
+    return occurrence <= Counter{4} ||
+           (occurrence & (occurrence - Counter{1})) == Counter{0};
+}
+
+} // namespace Common
