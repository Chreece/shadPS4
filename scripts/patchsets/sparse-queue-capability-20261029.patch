+// A graphics/compute family need not support sparse memory operations. Keep
+// rendering on its existing family and request a second queue only when needed.
+static std::optional<u32> FindSparseQueueFamily(
+    std::span<const vk::QueueFamilyProperties> families, u32 graphics_family) {
+    const auto supports_sparse = [&](u32 index) {
+        return index < families.size() && families[index].queueCount != 0 &&
+               bool(families[index].queueFlags & vk::QueueFlagBits::eSparseBinding);
+    };
+    if (supports_sparse(graphics_family)) {
+        return graphics_family;
+    }
+    for (u32 index = 0; index < families.size(); ++index) {
+        if (supports_sparse(index)) {
+            return index;
+        }
+    }
+    return std::nullopt;
+}
