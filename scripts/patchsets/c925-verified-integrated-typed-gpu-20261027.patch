+// Verify that the four real sampler dwords are scalar resource inputs;
+// the actual texture ID is still selected by the guest GPU shader.
+static bool IsProvenUniformSamplerWord(IR::Value value) {
+    if (value.IsImmediate()) return true;
+    const IR::Inst* inst = value.TryInst();
+    if (!inst) return false;
+    if (inst->GetOpcode() == IR::Opcode::GetUserData ||
+        inst->GetOpcode() == IR::Opcode::ReadConst) return true;
+    if (inst->GetOpcode() != IR::Opcode::ReadConstBuffer ||
+        !inst->Arg(1).IsImmediate()) return false;
+    const IR::Inst* descriptor = inst->Arg(0).TryInst();
+    if (!descriptor || descriptor->GetOpcode() != IR::Opcode::CompositeConstructU32x4 ||
+        descriptor->NumArgs() != 4u) return false;
+    for (u32 i = 0; i < 4u; ++i) {
+        const IR::Value word = descriptor->Arg(i);
+        if (word.IsImmediate()) continue;
+        const IR::Inst* producer = word.TryInst();
+        if (!producer ||
+            (producer->GetOpcode() != IR::Opcode::GetUserData &&
+             producer->GetOpcode() != IR::Opcode::ReadConst)) return false;
+    }
+    return true;
+}
+
+static bool IsProvenUniformSampler(const SharpReference& sharp) {
+    if (sharp.num_dwords != 4u || sharp.post_op != SharpFetchPostOp::None) return false;
+    for (u32 i = 0; i < 4u; ++i) {
+        if (!IsProvenUniformSamplerWord(sharp.dwords[i])) return false;
+    }
+    return true;
+}
