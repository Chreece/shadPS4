@@ -0,0 +1,45 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <cstdint>
+#include <limits>
+#include <optional>
+
+namespace VideoCore::Coherence {
+
+struct CpuWriteSpan {
+    std::uint64_t address;
+    std::uint64_t size;
+    constexpr bool operator==(const CpuWriteSpan&) const = default;
+};
+
+// A CPU store faults before execution. Preserve GPU-owned bytes in all tracking
+// pages touched by that store before removing protection. Adjacent pages are
+// unrelated ownership transfers, not an opportunistic prefetch opportunity.
+[[nodiscard]] constexpr std::optional<CpuWriteSpan> RequiredCpuWriteSpan(
+    std::uint64_t address, std::uint64_t size, std::uint64_t arena_address,
+    std::uint64_t arena_size, std::uint64_t page_size) noexcept {
+    constexpr auto max = std::numeric_limits<std::uint64_t>::max();
+    if (size == 0 || page_size == 0 || (page_size & (page_size - 1)) != 0 ||
+        arena_size == 0 || arena_address > max - arena_size) {
+        return std::nullopt;
+    }
+    const auto arena_end = arena_address + arena_size;
+    if (address < arena_address || address >= arena_end || size > arena_end - address) {
+        return std::nullopt;
+    }
+    auto begin = address & ~(page_size - 1);
+    if (begin < arena_address) {
+        begin = arena_address;
+    }
+    auto end = address + size;
+    const auto remainder = end & (page_size - 1);
+    if (remainder != 0) {
+        const auto padding = page_size - remainder;
+        end += padding <= arena_end - end ? padding : arena_end - end;
+    }
+    return CpuWriteSpan{begin, end - begin};
+}
+
+} // namespace VideoCore::Coherence
