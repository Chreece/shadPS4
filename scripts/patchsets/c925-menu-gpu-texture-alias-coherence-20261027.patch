 void TextureCache::MarkAsMaybeGpuDirty(VAddr addr, size_t size) {
     ForEachImageInRegion(addr, size, [&](ImageId image_id, Image& image) {
+        // GPU-dirty/CPU-dirty images have no trustworthy baseline on the host.
+        // Only preserve a baseline for an image whose GPU contents are valid.
+        // This prevents the subsequent image refresh/GC from accidentally
+        // keeping stale textures after raw storage-buffer writes.
+        if (!image.HasGpuValidData()) {
+            return;
+        }
         if (image.gpu_hash == 0) {
-            // Read backing pages directly, without faulting through the guest readback path.
+            // Read backing pages directly without recursively faulting.
             image.gpu_hash = HashBackingMemory(image.info.guest_address, image.info.guest_size);
         }
     });
 }
 
