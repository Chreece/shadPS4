     if (recreate) {
         auto new_info = requested_info;
-        new_info.resources = std::max(requested_info.resources, cache_image.info.resources);
+        // Mip count and array-layer count are independent dimensions. Choosing
+        // one whole extent lexicographically can retain too few layers/mips.
+        new_info.resources = {
+            .levels = std::max(requested_info.resources.levels, cache_image.info.resources.levels),
+            .layers = std::max(requested_info.resources.layers, cache_image.info.resources.layers),
+        };
+        ASSERT(new_info.resources.Contains(requested_info.resources));
+        ASSERT(new_info.resources.Contains(cache_image.info.resources));
+        const bool crossed_extents =
+            (requested_info.resources.levels > cache_image.info.resources.levels &&
+             requested_info.resources.layers < cache_image.info.resources.layers) ||
+            (requested_info.resources.levels < cache_image.info.resources.levels &&
+             requested_info.resources.layers > cache_image.info.resources.layers);
+        if (crossed_extents) {
+            static std::atomic<u32> reported{};
+            if (reported.fetch_add(1, std::memory_order_relaxed) < 16u) {
+                LOG_INFO(Render_Vulkan,
+                         "DepthExtentMerge: address={:#x} cached={}x{} requested={}x{} merged={}x{}",
+                         requested_info.guest_address, cache_image.info.resources.levels,
+                         cache_image.info.resources.layers, requested_info.resources.levels,
+                         requested_info.resources.layers, new_info.resources.levels,
+                         new_info.resources.layers);
+            }
+        }
         new_info.UpdateSize();
         const auto new_image_id = slot_images.Insert(instance, runtime, slot_image_views, new_info);
         RegisterImage(new_image_id);
