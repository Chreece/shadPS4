diff --git a/src/shader_recompiler/guest_descriptor_coherence.h b/src/shader_recompiler/guest_descriptor_coherence.h
new file mode 100644
index 0000000000000000000000000000000000000000..6fc2149ed723ec329dfaaf50c914d1b28a697185 100644
--- /dev/null
+++ b/src/shader_recompiler/guest_descriptor_coherence.h
@@ -0,0 +1,28 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <cstdint>
+#include <limits>
+#include <optional>
+
+namespace Shader::Optimization {
+
+// Exact minimum guest-table prefix needed to read each represented T# or S#.
+// Unlike the V# declared length, this bounds coherence to the descriptors
+// we will actually inspect, preserving mapping checks and sparse residency.
+constexpr std::optional<std::uint64_t> GuestDescriptorPrefixBytes(
+    std::uint64_t entries, std::uint64_t record_stride,
+    std::uint64_t descriptor_offset, std::uint64_t descriptor_size) noexcept {
+    if (entries == 0) return std::uint64_t{0};
+    if (record_stride == 0 || descriptor_size == 0 ||
+        descriptor_offset > record_stride ||
+        descriptor_size > record_stride - descriptor_offset) return std::nullopt;
+    const auto tail_bytes = descriptor_offset + descriptor_size;
+    const auto prefix_records = entries - 1;
+    if (prefix_records > (std::numeric_limits<std::uint64_t>::max() - tail_bytes) /
+                             record_stride) return std::nullopt;
+    return prefix_records * record_stride + tail_bytes;
+}
+
+} // namespace Shader::Optimization
diff --git a/tests/guest_descriptor_coherence_test.cpp b/tests/guest_descriptor_coherence_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..cf7662763d5b41fde5781a3f5010549605bad147 100644
--- /dev/null
+++ b/tests/guest_descriptor_coherence_test.cpp
@@ -0,0 +1,20 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <cstdint>
+#include <iostream>
+#include <limits>
+#include "shader_recompiler/guest_descriptor_coherence.h"
+using Shader::Optimization::GuestDescriptorPrefixBytes;
+int main() {
+    if (GuestDescriptorPrefixBytes(0,32,0,32)!=0) return 1;
+    if (GuestDescriptorPrefixBytes(1,32,0,32)!=32) return 2;
+    if (GuestDescriptorPrefixBytes(27651,32,0,32)!=884832) return 3;
+    if (GuestDescriptorPrefixBytes(27651,32,0,16)!=884816) return 4;
+    if (GuestDescriptorPrefixBytes(27651,32,16,16)!=884832) return 5;
+    if (GuestDescriptorPrefixBytes(500,32,17,16).has_value()) return 6;
+    if (GuestDescriptorPrefixBytes(5,0,0,16).has_value()) return 7;
+    if (GuestDescriptorPrefixBytes(100000000000ULL,UINT64_MAX,0,1).has_value()) return 8;
+    if (GuestDescriptorPrefixBytes(1,32,0,0).has_value()) return 9;
+    if (GuestDescriptorPrefixBytes(32,32,0,16)!=1008) return 10;
+    std::cout<<"GUEST_DESCRIPTOR_PREFIX_COHERENCE=PASS\n";
+}
